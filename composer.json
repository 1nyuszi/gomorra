{
    "name": "gomorra/low-code-engine",
    "description": "Metadata-driven engine with HTTP, CLI and MCP adapters",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "symfony/console": "8.0.*",
        "symfony/dependency-injection": "8.0.*",
        "symfony/framework-bundle": "8.0.*",
        "symfony/http-foundation": "8.0.*",
        "symfony/routing": "8.0.*",
        "symfony/serializer": "8.0.*",
        "symfony/yaml": "8.0.*"
    },
    "autoload": {"psr-4": {"App\\": "src/"}},
    "scripts": {
        "test": "php tests/run.php",
        "test:cli": "php tests/cli.php"
    },
    "config": {"sort-packages": true}
}
